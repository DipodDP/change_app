  "narrative": {
    "northStar": "The Ledger Light",
    "overview": "A dark room where only the numbers glow. The ground is near-black because the figures written on it are the entire product; amber is the money, and everything else — labels, chrome, borders — recedes into slate so that nothing competes with a payout figure. The interface is the page a ledger is written on, not an instrument panel.\n\nThis system is flat on purpose. A ledger has no shadows: depth comes from tonal layering, one surface tone lifted off another, with a single hairline border to separate them. Motion is similarly restrained — one duration, one easing, used only to acknowledge a pointer. Nothing animates to impress.\n\nNumbers are set in Fira Code with tabular figures wherever they appear, so digits align in a column and two amounts can be compared by eye without reading them. Prose is set in Fira Sans and stays quiet. The typographic hierarchy inverts the usual arrangement: the largest type on the page is not a heading but a sum of money.",
    "keyCharacteristics": [
      "Near-black OLED ground; tonal layering instead of shadow",
      "Amber reserved for money and the winning route",
      "Violet for actions, never for data",
      "Monospaced tabular numerals for every figure",
      "One motion duration (180ms ease), pointer feedback only",
      "Bilingual EN/RU; layouts absorb ~30% string growth"
    ],
    "rules": [
      {
        "name": "The Money Rule",
        "body": "Amber marks money and the winner — nothing else. The winning payout, the tag that names it, and the brand mark. The focus ring is the one carve-out, because an accessibility affordance must be the most visible thing on the page when it appears. When everything is amber, no route is the best one.",
        "section": "colors"
      },
      {
        "name": "The Actions Are Not Data Rule",
        "body": "Violet belongs to controls the user presses. A figure is never violet; a button is never amber.",
        "section": "colors"
      },
      {
        "name": "The Recession Rule",
        "body": "Inputs are darker than the surface holding them. A field is a well the user fills, not a raised element.",
        "section": "colors"
      }
    ],
    "dos": [
      "Set every figure in mono with tabular numerals",
      "Keep amber for money and the winner; let its rarity do the work",
      "Express depth as tone, and grouping as space",
      "Give a destructive action its own confirmation page with real counts",
      "Name the bank on the arrow, where the conversion happens",
      "Write for EN and RU together; leave room for ~30% growth",
      "State a rate as historical; it came from a conversion already made"
    ],
    "donts": [
      "Add a shadow to a flat surface, or a halo with no offset",
      "Use amber for ordinary emphasis, or violet for a number",
      "Nest a card inside a card",
      "Introduce a spacing value between the scale's steps",
      "Let a section's internal padding rival the gap between sections",
      "Imply a rate is a live market quote — it never is",
      "Add a second motion duration or an entrance animation",
      "Use an emoji or a Unicode glyph where an icon belongs (icons are drawn SVG, 2–2.5px stroke, currentColor)"
    ]
  }
